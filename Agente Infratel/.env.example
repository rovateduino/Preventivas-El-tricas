# Copie para ".env" (que esta no .gitignore) e edite.
# IMPORTANTE: apenas dados FICTICIOS aqui. Nunca coloque sua senha real.

# Allowlist de dominios onde o agente PODE navegar (separados por virgula).
AGENT_ALLOWED_DOMAINS=example.com

# URL alvo do fluxo de demonstracao (ainda NAO faca login real).
AGENT_TARGET_URL=https://example.com/login

# Credenciais FICTICIAS apenas para validar o esqueleto.
TEST_AGENT_USER=teste.user@example.com
TEST_AGENT_PASS=SenhaFicticia#123

# Segredo-mestre do cofre (usado APENAS pela opcao B / computer-use-mcp-agent).
# Nao e uma credencial de site; e a chave de criptografia do cofre.
# Deixe VAZIO aqui e exporte no shell. Gere um valor forte com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
COMPUTER_USE_VAULT_SECRET=
