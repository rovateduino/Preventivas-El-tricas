{
  "entities": {
    "preventiva": {
      "title": "Preventiva",
      "description": "Registro de manutenção preventiva elétrica",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "data": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "tipoQuadro": { "type": "string" },
        "ticket": { "type": "string" },
        "temperatura": { "type": "number" },
        "site": { "type": "object" },
        "circuitos": { "type": "array" },
        "medicaoCorrente": { "type": "object" },
        "criadoEm": { "type": "number" },
        "atualizadoEm": { "type": "number" }
      },
      "required": ["id", "uid", "data", "tipoQuadro", "ticket", "temperatura", "site", "circuitos", "medicaoCorrente", "criadoEm"]
    }
  },
  "firestore": {
    "/preventivas/{preventivaId}": {
      "schema": "preventiva",
      "description": "Coleção de registros de preventivas"
    }
  }
}
